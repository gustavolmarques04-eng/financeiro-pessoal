# Copie este arquivo para .env e ajuste o que precisar.
# O .env NÃO deve ir para o controle de versão.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Vazio ou ausente = SQLite local em data/financeiro.db
# DATABASE_URL=sqlite:///data/financeiro.db
#
# Para migrar para PostgreSQL/Supabase, basta trocar esta linha:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nome_do_banco
# (instale também: pip install "psycopg[binary]")

# ---------------------------------------------------------------------------
# Senha do aplicativo
# ---------------------------------------------------------------------------
# Se definida, uma tela de senha aparece antes do aplicativo.
# Deixe em branco/ausente para rodar sem senha no seu computador.
# APP_PASSWORD=troque-por-uma-senha-forte
