# Modelo dos segredos. NÃO comite o secrets.toml de verdade.
#
# No Streamlit Community Cloud, cole este conteúdo (com os valores reais)
# em Settings → Secrets. Localmente, prefira o arquivo .env.

# Banco PostgreSQL (Supabase, Neon...). Sem isso, usa o SQLite local.
DATABASE_URL = "postgresql+psycopg://usuario:senha@host:5432/postgres"

# Senha para abrir o aplicativo. Obrigatória quando publicado.
APP_PASSWORD = "troque-por-uma-senha-forte"
